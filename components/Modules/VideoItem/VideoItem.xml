<?xml version="1.0" encoding="utf-8"?>

<component name="VideoItem" extends="Group">

    <interface>
        <function name="onDestroy" />
        <field id="supportsDisposal" type="boolean" value="true" />
        <field id="itemContent" type="node" onChange="showcontent" />
        <field id="rowFocusPercent" type="float" onChange="showrowfocus" />
        <field id="itemHasFocus" type="boolean" onChange="onGetfocus" />
    </interface>

    <script type="text/brightscript" uri="VideoItem.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <children>
        <Poster
            id="itemPoster"
            height="180"
            width="320"
            loadWidth="320"
            loadHeight="180"
            loadDisplayMode="scaleToFit">
            <!-- Native LIVE badge: red fill marks live only; text is localized -->
            <Group id="liveIcon" translation="[6,6]">
                <Rectangle id="liveBadge" color="0xEB0400FF" width="52" height="24" />
                <Label
                    id="liveLabel"
                    text="LIVE"
                    color="0xFFFFFFFF"
                    width="52"
                    height="24"
                    horizAlign="center"
                    vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
                </Label>
            </Group>

        </Poster>
        <CirclePoster id="circlePoster" height="150" width="150" visible="false" />
        <Rectangle
            id="itemMask"
            color="0x0e0e10ff"
            visible="false"
            opacity="0.75"
            width="512"
            height="288"
            scaleRotateCenter="[ 256.0, 144.0 ]" />
        <EmojiLabel
            id="itemLabel"
            height="28"
            maxWidth="320"
            color="0xEFEFF1FF"
            translation="[0, 192]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="22" />
        </EmojiLabel>
        <Label
            id="itemSubtitle"
            height="24"
            width="320"
            horizAlign="left"
            color="0xADADB8FF"
            translation="[0, 222]">
            <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="18" />
        </Label>
        <Poster
            id="viewsRect"
            uri="pkg:/images/live_rectangle.9.png"
            translation="[6,152]">
        </Poster>
        <Label
            id="itemViewers"
            horizAlign="left"
            color="0xFFFFFFFF"
            translation="[9,152]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
        </Label>
        <Poster
            id="runtimeRect"
            uri="pkg:/images/live_rectangle.9.png"
            visible="false"
            translation="[5,23]">
        </Poster>
        <Label
            id="runtimeLabel"
            horizAlign="left"
            color="0xFFFFFFFF"
            visible="false"
            translation="[7,23]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
        </Label>
        <Poster
            id="timestampRect"
            uri="pkg:/images/live_rectangle.9.png"
            translation="[6,6]">
        </Poster>
        <Label
            id="timestampLabel"
            horizAlign="left"
            color="0xFFFFFFFF"
            translation="[9,6]">
            <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="16" />
        </Label>

    </children>

</component>
