<?xml version="1.0" encoding="utf-8"?>
<component name="GamePage" extends="SceneManagerGroup" initialFocus="homeRowList">
    <interface>
        <function name="onDestroy" />
        <field id="contentRequested" type="node" onChange="updatePage" />
        <field id="backgroundColor" type="string" alias="background.color" />
        <field id="pageTitle" type="string" alias="Header.text" />
    </interface>
    <script type="text/brightscript" uri="GamePage.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/misc.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/contentBuilder.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/taskFactory.brs" />
    <script type="text/brightscript" uri="pkg:/components/Modules/StatusPanel/StatusPanelHost.brs" />
    <children>
        <rectangle id="background" width="1920" height="1080" />
        <SimpleLabel
            id="Header"
            translation="[110,24]"
            text=""
            fontSize="40"
            color="0xEFEFF1FF"
            fontUri="pkg:/fonts/Archivo-Bold.otf" />
        <RowList
            id="homeRowList"
            visible="true"
            rowLabelOffset="[[0,5]]"
            rowLabelColor="0xEFEFF1FF"
            translation="[ 110, 96 ]"
            itemComponentName="VideoItem"
            numRows="4"
            rowItemSize="[[320,180]]"
            rowItemSpacing="[[30,0]]"
            itemSize="[1280,295]"
            itemSpacing="[ 0, 40 ]"
            showRowLabel="[ false ]"
            rowHeights="[255]"
            focusBitmapUri="pkg:/images/focusindicator.9.png"
            vertFocusAnimationStyle="fixedFocus"
            rowFocusAnimationStyle="fixedFocus">
            <Font role="rowLabelFont" uri="pkg:/fonts/Archivo-Bold.otf" size="24" />
        </RowList>
        <StatusPanel id="status" translation="[110, 200]" />
    </children>

</component>
