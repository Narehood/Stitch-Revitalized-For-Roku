<component name="Settings" extends="SceneManagerGroup" initialFocus="settingsMenu">
    <interface>
        <function name="onDestroy" />
        <field id="finished" type="bool" />
    </interface>
    <children>
        <Rectangle id="background" translation="[0,64]" width="1280" height="656" color="0x0E0E10FF" />
        <!-- Each row shows the setting name and its current value -->
        <MarkupList
            id="settingsMenu"
            translation="[110,96]"
            itemComponentName="SettingsListItem"
            itemSize="[520,60]"
            itemSpacing="[0,4]"
            numRows="9"
            vertFocusAnimationStyle="floatingFocus"
            focusBitmapUri="pkg:/images/focusindicator.9.png"
            focusFootprintBitmapUri="pkg:/images/transparent.9.png" />
        <Rectangle id="detailsCard" translation="[662,96]" width="570" height="592" color="0x1F1F23FF" />
        <LayoutGroup
            id="settingDetail"
            translation="[694,128]"
            layoutDirection="vert"
            vertAlignment="top"
            horizAlignment="left"
            itemSpacings="[16]">
            <Label id="settingTag" visible="false" color="0xFFD37AFF">
                <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="18" />
            </Label>
            <Label id="settingTitle" width="506" wrap="true" maxLines="2" color="0xEFEFF1FF">
                <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="28" />
            </Label>
            <Label id="settingDesc" width="506" wrap="true" maxLines="8" lineSpacing="6" color="0xADADB8FF">
                <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="20" />
            </Label>
            <Label id="settingValue" visible="false" width="506" wrap="true" maxLines="2" color="0xEFEFF1FF">
                <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="18" />
            </Label>
            <!-- Off/On or the setting's options; focusable after OK -->
            <RadioButtonList
                id="optionList"
                visible="false"
                itemSize="[506,44]"
                itemSpacing="[0,4]"
                numRows="6"
                vertFocusAnimationStyle="floatingFocus"
                color="0xEFEFF1FF"
                focusedColor="0xFFFFFFFF"
                focusBitmapUri="pkg:/images/focusindicator.9.png"
                focusFootprintBitmapUri="pkg:/images/transparent.9.png" />
            <Poster
                id="supportQrPoster"
                uri="pkg:/images/qr_buymeacoffee.png"
                width="240"
                height="240"
                visible="false" />
        </LayoutGroup>
    </children>
    <script type="text/brightscript" uri="settings.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/taskFactory.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/misc.brs" />
</component>
