<?xml version="1.0" encoding="utf-8"?>
<component name="VideoPlayer" extends="SceneManagerGroup" initialFocus="videoWindow">
    <interface>
        <function name="onDestroy" />
        <function name="requestBack" />
        <field id="channelRequested" type="node" />
        <field id="channelPinChanged" type="boolean" alwaysNotify="true" />
        <field id="channelFollowChanged" type="boolean" alwaysNotify="true" />
        <field id="channelSignInRequested" type="boolean" alwaysNotify="true" />
        <field id="contentRequested" type="Node" onChange="handleContent" />
        <field id="contentStore" type="assocarray" />
        <field id="metadata" type="array" />
        <field id="content" type="node" />

        <!-- state - Same as Task states. -->
        <field id="state" type="string" alwaysNotify="true" />

        <!-- control - "play" starts content playback -->
        <field id="control" type="string" alwaysNotify="true" onChange="controlChanged" />
        <field id="streams" type="assocarray" />
        <field id="ChatStarted" type="bool" value="false" />
        <field id="engagementStatus" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="VideoPlayer.brs" />
    <script type="text/brightscript" uri="ChannelFollow.brs" />
    <script type="text/brightscript" uri="ContentAdvisory.brs" />
    <script type="text/brightscript" uri="ChatLayout.brs" />
    <script type="text/brightscript" uri="RokuPlayback.brs" />
    <script type="text/brightscript" uri="LowLatencyPlayback.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuDemuxDescriptor.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuVodIndex.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuVodDescriptor.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/rokuVodRuntime.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/playbackHls.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/deviceCapabilities.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/twitchAdCountdown.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/misc.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/recentlyWatched.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/taskFactory.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils/analytics.brs" />
    <children>
        <Group id="contentAdvisory" visible="false" translation="[48,40]">
            <Rectangle width="800" height="200" color="0x18181BF2" />
            <Rectangle width="4" height="200" color="0xA970FFFF" />
            <Label id="advisoryTitle" width="752" height="36" translation="[24,16]" color="0xEFEFF1FF">
                <Font role="font" uri="pkg:/fonts/Archivo-Bold.otf" size="26" />
            </Label>
            <Label id="advisoryLabels" width="752" height="130" translation="[24,56]" color="0xEFEFF1FF" wrap="true" maxLines="5">
                <Font role="font" uri="pkg:/fonts/Archivo-Regular.otf" size="22" />
            </Label>
        </Group>
        <Chat
            id="chat"
            visible="false"
            translation="[960,0]"
            forceLive="false" />
        <TwitchApiTask
            id="bookmarksTask"
            functionName="getTwitchBookmarks"
        />
    </children>

</component>
