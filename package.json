{
  "name": "@narehood/stitch-revitalized-for-roku",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "bsc --createPackage=false",
    "watch": "npm run build -- --watch",
    "package": "bsc --create-package",
    "lint": "bslint",
    "audit": "node tools/audit-dependencies.js",
    "lint:fix": "bslint --fix",
    "fmt": "brighterscript-formatter --write \"source/**/*.{brs,bs}\" \"components/**/*.{brs,bs}\"",
    "fmt:check": "brighterscript-formatter --check \"source/**/*.{brs,bs}\" \"components/**/*.{brs,bs}\"",
    "test": "node tools/run-offline-tests.js && node --test tools/tests/*.test.js",
    "test:compile": "node tools/prepare-device-tests.js && bsc --project bsconfig.test.json --create-package",
    "test:device": "npm run test:compile && node tools/deploy-test.js",
    "prepare": "husky",
    "sign": "node scripts/sign-package.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@rokucommunity/bslint": "^0.8.46",
    "brighterscript": "0.73.5",
    "brighterscript-formatter": "^1.8.3",
    "brs-node": "2.6.0",
    "husky": "^9.1.7",
    "rooibos-roku": "^5.17.0",
    "roku-deploy": "^3.18.4"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "qs": "^6.16.0",
    "tough-cookie": "^4.1.3",
    "lodash": "4.18.1",
    "@xml-tools/common": {
      "lodash": "4.18.1"
    },
    "@xml-tools/ast": {
      "lodash": "4.18.1"
    },
    "ws": "^8.21.1",
    "js-yaml": "^4.3.2",
    "uuid": "^11.1.1",
    "brs-node": {
      "uuid": "^14.0.0"
    },
    "brace-expansion@1": "^1.1.21",
    "fast-uri@3": "^3.1.8",
    "ip-address": "^10.7.3",
    "moment": "^2.31.0"
  }
}
